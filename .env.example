# Valores reais são provisionados pelo Marketplace e baixados por vercel env pull.
# Somente a chave PUBLICÁVEL é incluída no bundle Vite.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Bancos isolados de Preview/Development. Nunca usar o diário principal nos testes.
LEVE_DATABASE_URL=
LEVE_DATABASE_URL_UNPOOLED=
# IDs internos Clerk dos moderadores, separados por vírgula. Apenas no servidor.
FOOD_MODERATOR_IDS=
# Ativar SOMENTE em Production após desligar Medição otimizada no fluxo GA4.
LEVE_GA4_REVIEWED=false
# Origens adicionais autorizadas, separadas por vírgula, para domínios próprios.
APP_ORIGINS=

# URL pública opcional para canonical/OG. Em prévias, omitir para usar a URL da implantação.
# SITE_URL=https://leve-fawn.vercel.app
